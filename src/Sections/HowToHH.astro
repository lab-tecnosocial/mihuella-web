---
const Higiene = new URL("../assets/images/wash.webp", import.meta.url).href;
const Limpieza = new URL("../assets/images/laundry.webp", import.meta.url).href;
const Alimentacion = new URL("../assets/images/lunch_dining.webp", import.meta.url).href;
const BienesyServicios = new URL("../assets/images/bienes.webp", import.meta.url).href;
const HabitosSostenibles = new URL("../assets/images/habitos_sost.webp", import.meta.url).href;
import CaculateCard from "../components/CaculateCard.astro";

---

<section
  id="calcular"
  class="flex flex-col items-center gap-5 justify-between bg-[#F5F5F5] py-4 md:py-16 px-4 md:px-[100px] mx-auto my-auto max-w-[1440px]  min-w-[100%] scroll-m-10"
>
  <h1 class="text-center text-xl md:text-6xl font-bold">
    Calculadora de Huella Hídrica  </h1>
    <h2 class="text-center md:text-2xl">La prueba dura aproximadamente 5 minutos</h2>
    <h2 class="text-center md:text-2xl">Evalúa tu consumo de agua en cinco categorías principales:</h2>
  <div class="flex flex-col md:flex-row mb-20 gap-2 md:justify-between w-full">
    <CaculateCard
      img={Higiene}
      text="Higiene"
      altImg="Higiene"
      withImg="100px"
      stylesComponent="md:h-auto mt-5 transition ease-in-out duration-500 transform hover:scale-110 hover:bg-transparent mb-30"
    />

    <CaculateCard
      img={Limpieza}
      text="Limpieza"
      altImg="Limpieza"
      withImg="100px"
      stylesComponent="md:h-auto mt-5 transition ease-in-out duration-500 transform hover:scale-110 hover:bg-transparent mb-30"
    />

    <CaculateCard
      img={Alimentacion}
      text="Dieta"
      altImg="Imagen Dieta"
      withImg="100px"
      stylesComponent="md:h-auto mt-5 transition ease-in-out duration-500 transform hover:scale-110 hover:bg-transparent mb-30"
    />
        <CaculateCard
      img={BienesyServicios}
      text="Bienes y Servicios"
      altImg="Imagen Bienes y Servicios"
      withImg="100px"
      stylesComponent="md:h-auto mt-5 transition ease-in-out duration-500 transform hover:scale-110 hover:bg-transparent mb-30"
    />
        <CaculateCard
      img={HabitosSostenibles}
      text="Hábitos Sostenibles"
      altImg="Imagen Hábitos Sostenibles"
      withImg="100px"
      stylesComponent="md:h-auto mt-5 transition ease-in-out duration-500 transform hover:scale-110 hover:bg-transparent mb-30 "
    />
  </div>
    <h3 class="text-center text-base md:text-2xl max-w-[600px] mx-auto mt-4 md:mt-8 px-4 md:px-0 py-2 md:py-4">
     Aprende a ahorrar agua con consejos prácticos que cuidan tu bolsillo y el planeta.
    </h3>

</section>